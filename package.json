{
  "name": "opencard",
  "version": "1.0.0",
  "description": "Self-hosted digital business cards",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "seed": "ts-node prisma/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc src/*.test.ts --rootDir src --outDir .test-build --module commonjs --target ES2021 --esModuleInterop --skipLibCheck --resolveJsonModule --noCheck && node --test \".test-build/**/*.test.js\""
  },
  "dependencies": {
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/client": "^5.22.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "multer": "^2.0.0",
    "nodemailer": "^6.10.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
