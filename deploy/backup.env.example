# Copy to deploy/backup.env (gitignored) for offsite backups.
# Wasabi example: https://s3.us-east-1.wasabisys.com
# Cloudflare R2 and other S3-compatible services also work.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local snapshots older than this many days are deleted after a successful run.
KEEP_LOCAL_DAYS=7
