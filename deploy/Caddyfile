# Optional, generic HTTPS proxy for a single self-hosted OpenCard instance.
# APP_DOMAIN is the hostname from APP_URL. Caddy manages public certificates.
{
	on_demand_tls {
		ask http://web:3000/tls/authorize
	}
}

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# Additional login hosts registered and approved in Admin > Domains.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy web:3000
}
