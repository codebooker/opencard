# Copy to .env. Never commit the filled-in file.
# Generate each secret independently with: openssl rand -hex 32
DB_PASSWORD=
APP_DB_PASSWORD=
SESSION_SECRET=

# Name of the one workspace created on first boot. Change it later in the app.
COMPANY_NAME=My Company

# Direct local install: leave these defaults and use http://localhost:3000.
# For the optional Caddy HTTPS proxy, set APP_DOMAIN=cards.example.com,
# APP_URL=https://cards.example.com and TRUST_PROXY_HOPS=1.
APP_DOMAIN=localhost
APP_URL=http://localhost:3000
CARD_URL=
BIND_ADDRESS=127.0.0.1
PORT=3000
TRUST_PROXY_HOPS=0

# Point this at the actual source for any modified version you run.
SOURCE_URL=https://github.com/codebooker/opencard

# Optional offsite target for backups created in Admin → Backups.
# For Wasabi/R2/etc., specify the provider's HTTPS S3 endpoint.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional DNS verification for additional branded login hosts.
# TENANTS_CNAME_TARGET defaults to the APP_URL hostname.
TENANTS_CNAME_TARGET=
SERVER_IPS=

# Employee self-service sign-in (Microsoft Entra OIDC or per-workspace SAML).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Disposable demo only, and only active together with SEED_DEMO=1.
# Anyone who knows a card owner's email can sign in when enabled.
SELF_SERVICE_DEV_LOGIN=0

# Optional mail for admin invites, password reset and lead notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional legacy SCIM token; per-workspace tokens are created in Integrations.
SCIM_TOKEN=

# No demo people/cards are inserted unless explicitly enabled for a test install.
SEED_DEMO=0
WEBHOOK_DELIVERY_RETENTION_DAYS=30

# Optional third-party accessibility widget. Off by default.
USERWAY_ACCOUNT=off
