# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://opencard:opencard@localhost:5432/opencard?schema=public"

# Public base URL of this deployment (used for QR codes and card links)
BASE_URL="http://localhost:3000"
PORT="3000"

# Static admin token (first-run / offline). Send as: Authorization: Bearer <token>
# or visit /admin/login and paste it.
ADMIN_TOKEN="changeme-admin-token"

# Bearer token Azure AD/Entra uses to authenticate to the SCIM provisioning endpoint.
SCIM_TOKEN="changeme-scim-token"

# Secret used to sign employee self-service session cookies. Use a long random value.
SESSION_SECRET="changeme-session-secret"

# Postgres password used by docker-compose
DB_PASSWORD="opencard"

# --- Employee self-service sign-in (Azure AD / Entra OIDC) ---
# Set all three to enable SSO at /me. Redirect URI in Entra: <BASE_URL>/me/auth/callback
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Local testing ONLY: "1" lets employees sign in by typing an email (no IdP).
# Leave at 0 in production.
SELF_SERVICE_DEV_LOGIN="0"
