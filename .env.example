# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32

# --- Core ---
DATABASE_URL="postgresql://opencard:opencard@localhost:5432/opencard?schema=public"
# Password for the least-privilege runtime role (opencard_app) that enforces
# Postgres row-level security. REQUIRED in production — the app refuses to boot
# without it so tenant isolation isn't left to app-level filters alone.
APP_DB_PASSWORD=""
# Postgres password used by docker-compose for the owner role.
DB_PASSWORD=""

# Public base URL of this deployment (used for QR codes and card links).
BASE_URL="http://localhost:3000"
# Optional overrides: APP_URL aliases BASE_URL; CARD_URL is the host public
# cards resolve on (defaults to BASE_URL). PLATFORM_DOMAIN enables subdomain
# tenant addressing (e.g. acme.opencard.id).
# APP_URL=""
# CARD_URL=""
# PLATFORM_DOMAIN=""
PORT="3000"
# Reverse-proxy hop count for `trust proxy` (1 = behind Caddy). Never use true.
TRUST_PROXY_HOPS="1"

# --- Secrets ---
# Admin login is a real per-user account (see: node dist/scripts/make-admin.js).
# There is NO static admin token.
# Secret used to sign admin/employee session cookies AND encrypt recoverable
# integration secrets (CRM tokens, webhook secrets). Long random value.
SESSION_SECRET=""
# Bearer token Azure AD/Entra uses to authenticate to the SCIM endpoint.
SCIM_TOKEN=""

# --- Self-service signup ---
# On in dev; in production, off unless "1" AND SMTP is configured (magic-link
# email verification is required — no auto-verified accounts).
SIGNUPS_ENABLED="0"

# --- Employee self-service sign-in (Azure AD / Entra OIDC) ---
# Set all three to enable SSO at /me. Redirect URI in Entra: <BASE_URL>/me/auth/callback
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
# Local testing ONLY: "1" lets employees sign in by typing an email (no IdP).
SELF_SERVICE_DEV_LOGIN="0"

# --- Email (SMTP) ---
# Required in production if signups or lead notifications are enabled. When
# unset, mail is not sent (logged in dev only; production fails closed).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Billing (Stripe) ---
# All optional; when STRIPE_SECRET_KEY is unset, checkout and the webhook are
# inert and plans are assigned by platform staff.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_INDIVIDUAL=""
STRIPE_PRICE_TEAM=""
STRIPE_PRICE_MULTI_LOCATION_BRAND=""
STRIPE_PRICE_ENTERPRISE=""

# --- Accessibility widget (UserWay) ---
# Defaults to the OpenCard account; set "off" to disable, or your own key.
# USERWAY_ACCOUNT=""

# --- Wallet passes (optional, inert until configured) ---
# WALLET_APPLE_PASS_TYPE_ID=""
# WALLET_APPLE_TEAM_ID=""
# WALLET_APPLE_CERT_PATH=""
# WALLET_APPLE_KEY_PATH=""
# WALLET_APPLE_WWDR_PATH=""
# WALLET_GOOGLE_ISSUER_ID=""
# WALLET_GOOGLE_SERVICE_EMAIL=""
# WALLET_GOOGLE_SERVICE_KEY=""

# --- Uploads / backups ---
# UPLOAD_DIR="./uploads"
# BACKUP_DIR="./backups"
